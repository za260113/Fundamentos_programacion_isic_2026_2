Algoritmo practica23
    sumaLatencias <- 0
    latenciaMaxima <- 0
    Para i <- 1 Hasta 5 Hacer
        Escribir "Ingresa la latencia"
        Leer latencia
        sumaLatencias <- sumaLatencias + latencia
        Si latencia > latenciaMaxima Entonces
            latenciaMaxima <- latencia
        FinSi
    FinPara
    Escribir "Latencia promedio: ", sumaLatencias / 5
    Escribir "Latencia maxima: ", latenciaMaxima
FinAlgoritmo
